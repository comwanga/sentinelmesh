# Dev gateway with cargo-watch: rebuilds + restarts on source changes. Source is
# live-mounted at /workspace/{gateway,sentinel-core}/src; the target dir lives on
# a named volume so incremental compilation persists across restarts.
# Build context must be the workspace root (services/).
FROM rust:1.88-slim AS dev

WORKDIR /workspace

RUN apt-get update && apt-get install -y pkg-config libssl-dev wget && rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-watch --locked

# Cache workspace dependency builds before copying real source.
COPY Cargo.toml Cargo.lock ./
COPY sentinel-core/Cargo.toml sentinel-core/Cargo.toml
COPY gateway/Cargo.toml gateway/Cargo.toml

RUN mkdir -p sentinel-core/src gateway/src && \
    echo "pub fn _stub() {}" > sentinel-core/src/lib.rs && \
    echo "fn main() {}" > gateway/src/main.rs && \
    cargo build -p gateway 2>/dev/null || true && \
    rm -rf sentinel-core/src gateway/src

# Copy real source
COPY event_schema.json ./
COPY sentinel-core/src sentinel-core/src
COPY gateway/src gateway/src

RUN touch sentinel-core/src/lib.rs gateway/src/main.rs && \
    cargo build -p gateway

EXPOSE 3000

CMD ["cargo", "watch", "-x", "run -p gateway"]
