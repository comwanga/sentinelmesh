# Copy to .env for local Compose usage. Do not commit .env.

# Core database roles
POSTGRES_ADMIN_PASSWORD=replace_with_admin_database_password
APP_DATABASE_PASSWORD=replace_with_runtime_database_password
DATABASE_URL=postgresql://sentinel_app:replace_with_runtime_database_password@postgres:5432/sentinelmesh

# Core Redis
REDIS_PASSWORD=random-secret-password
REDIS_URL=redis://:random-secret-password@redis:6379

# Core gateway security
NODE_ENV=development
INTERNAL_SERVICE_SECRET=replace_with_at_least_32_random_characters
CIRCLE_TOKEN_SECRET=replace_with_a_distinct_stable_32_char_secret
PUBLIC_BASE_URL=http://localhost
TRUST_PROXY=true

# Optional gateway providers
# Map search/routing is disabled unless explicitly enabled. Keep this key server-side.
MAP_API_ENABLED=false
STADIA_API_KEY=
# Legacy map tile proxy only.
MAPBOX_TOKEN=
PINATA_JWT=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=

# Safety-sensitive server features. Keep disabled for the V2 core release.
SYNTHESIS_ENABLED=false
ACOUSTIC_CONFIRM_ENABLED=false
SAFE_CIRCLE_LOCATION_ENABLED=false
NLP_SYNTHESIS_ENABLED=true
CONSENSUS_REQUIRE_ESTABLISHED=true

# Number of gateway replicas. Safe circle location requires a single replica
# (removed-member socket invalidation is in-process and cannot reach others).
GATEWAY_REPLICAS=1

# Chat notifications (experimental). Requires a managed inbox relay per
# docs/operations/relay-conformance.md before enabling.
CHAT_PUSH_ENABLED=false
RELAY_WEBHOOK_SECRET=
RELAY_WEBHOOK_ALLOWED_SOURCE=

# PWA build-time configuration. VITE_* values are public and embedded in the image.
# Optional public TileJSON override; Stadia domain authentication requires no browser API key.
VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/data/openmaptiles.json
VITE_ENABLE_EXPERIMENTAL_ACOUSTIC=false
VITE_ENABLE_EXPERIMENTAL_CIRCLES=false
VITE_ENABLE_SAFE_CIRCLE_LOCATION=false
VITE_ENABLE_EXPERIMENTAL_INSIGHTS=false
VITE_ENABLE_EXPERIMENTAL_PHOTOS=false
VITE_ENABLE_EXPERIMENTAL_ROUTING=false
# Local builds disable the precache service worker by default so rebuilds appear
# immediately in the browser. Production keeps it enabled (override in
# docker-compose.production.yml).
VITE_DISABLE_SERVICE_WORKER=true
# Chat (NIP-29 public channels + NIP-17/NIP-59 encrypted DMs and Circle rooms).
# Disabled by default; requires relay endpoints to be product-decided.
VITE_ENABLE_CHAT=false
VITE_CHAT_INBOX_RELAY_URL=
VITE_CHAT_COMMUNITY_RELAY_URL=
VITE_CHAT_DISCOVERY_RELAYS=

# Optional signal and ML profiles
TWITTER_BEARER_TOKEN=
SENTRY_DSN=
WHISPER_MODEL=base

# Runtime tuning
MAX_DB_CONNECTIONS=50
LOG_LEVEL=info
