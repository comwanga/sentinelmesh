# Copy this to .env and fill in values. Never commit .env.

# Postgres
POSTGRES_PASSWORD=changeme_local
# DATABASE_URL must match POSTGRES_PASSWORD above — update both if you rotate the password
DATABASE_URL=postgresql://sentinel:changeme_local@postgres:5432/sentinelmesh

# Redis
REDIS_PASSWORD=changeme_local
REDIS_URL=redis://:changeme_local@redis:6379

# Auth
# [REQUIRED] Must be at least 64 random characters
JWT_SECRET=replace_with_64_char_random_string_minimum_length_required
# [REQUIRED] Used for service-to-service auth
INTERNAL_SERVICE_SECRET=replace_with_random_string

# Twitter/X
# [OPTIONAL] Stream is skipped if empty
TWITTER_BEARER_TOKEN=

# Mapbox
# [REQUIRED for PWA map]
VITE_MAPBOX_TOKEN=

# Whisper model size: base (dev), large-v3 (production)
WHISPER_MODEL=base

# Service ports (defaults used if not set)
GATEWAY_PORT=3000
SIGNAL_PORT=8000

# Logging
LOG_LEVEL=info

# Sentry
# [OPTIONAL in dev, REQUIRED in production]
SENTRY_DSN=
