# Copy this to .env and fill in values. Never commit .env.

# Postgres
POSTGRES_PASSWORD=changeme_local
# DATABASE_URL must match POSTGRES_PASSWORD above — update both if you rotate the password
DATABASE_URL=postgresql://sentinel:changeme_local@postgres:5432/sentinelmesh

# Redis
REDIS_PASSWORD=changeme_local
REDIS_URL=redis://:changeme_local@redis:6379

# Auth
# [REQUIRED] Must be at least 64 random characters
JWT_SECRET=replace_with_64_char_random_string_minimum_length_required
# [REQUIRED in production] Service-to-service auth. When NODE_ENV=production the
# gateway REFUSES TO START if this is unset, empty, or the dev default.
INTERNAL_SERVICE_SECRET=replace_with_random_string
# Set to "production" to enforce fail-closed secret validation above.
NODE_ENV=development

# IPFS pinning (report photos)
# [OPTIONAL] Server-side Pinata JWT. Used by the /api/photos/pin proxy so the
# credential is NEVER shipped to the browser. (The old VITE_PINATA_JWT is removed.)
PINATA_JWT=

# Community report consensus
# [OPTIONAL] Require distinct established (non-NEWCOMER) voters before a report
# can reach VERIFIED/AUTHORITATIVE (default false). Votes are always reputation-
# weighted; this only toggles the anti-Sybil gate. Turn ON once you have seeded
# or grown a base of trusted accounts.
CONSENSUS_REQUIRE_ESTABLISHED=false

# Blockchain anchoring
# [OPTIONAL] Master switch for auto-enqueuing on-chain anchors when a report
# reaches consensus (default false). Keep OFF until anchoring is decoupled from
# raw vote count and a hot-wallet spend cap exists (prevents Sybil fee-drain).
ANCHORING_ENABLED=false

# Acoustic synthesis
# [OPTIONAL] Master switch for the acoustic clustering worker (default false).
SYNTHESIS_ENABLED=false
# [OPTIONAL] Gates auto-confirmation of acoustic clusters into public map events
# (default false). While false, clusters corroborate for telemetry but are never
# auto-published. Keep OFF until server-side anti-spoof / independence checks land.
ACOUSTIC_CONFIRM_ENABLED=false

# Twitter/X
# [OPTIONAL] Stream is skipped if empty
TWITTER_BEARER_TOKEN=

# Mapbox
# [REQUIRED for PWA map]
VITE_MAPBOX_TOKEN=

# Whisper model size: base (dev), large-v3 (production)
WHISPER_MODEL=base

# Service ports (defaults used if not set)
GATEWAY_PORT=3000
SIGNAL_PORT=8000

# Logging
LOG_LEVEL=info

# Sentry
# [OPTIONAL in dev, REQUIRED in production]
SENTRY_DSN=
