# Copy to .env for local Compose usage. Do not commit .env.

# Core database roles
POSTGRES_ADMIN_PASSWORD=replace_with_admin_database_password
APP_DATABASE_PASSWORD=replace_with_runtime_database_password
DATABASE_URL=postgresql://sentinel_app:replace_with_runtime_database_password@postgres:5432/sentinelmesh

# Core Redis
REDIS_PASSWORD=d45aee6bab9bdf1a6dd1f28950ef38cb6b5d6da1f831874bf8b582bd671cf0fa
REDIS_URL=redis://:d45aee6bab9bdf1a6dd1f28950ef38cb6b5d6da1f831874bf8b582bd671cf0fa@redis:6379

# Core gateway security
NODE_ENV=development
INTERNAL_SERVICE_SECRET=replace_with_at_least_32_random_characters
CIRCLE_TOKEN_SECRET=replace_with_a_distinct_stable_32_char_secret
PUBLIC_BASE_URL=http://localhost
TRUST_PROXY=true

# Optional gateway providers
MAPBOX_TOKEN=
PINATA_JWT=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=

# Safety-sensitive server features. Keep disabled for the V2 core release.
SYNTHESIS_ENABLED=false
ACOUSTIC_CONFIRM_ENABLED=false
ANCHORING_ENABLED=false
NLP_SYNTHESIS_ENABLED=true
CONSENSUS_REQUIRE_ESTABLISHED=true

# PWA build-time configuration. VITE_* values are public and embedded in the image.
VITE_MAP_STYLE_URL=/sentinelmesh-dark.json
VITE_ENABLE_EXPERIMENTAL_ACOUSTIC=false
VITE_ENABLE_EXPERIMENTAL_BLOCKCHAIN=false
VITE_ENABLE_EXPERIMENTAL_CIRCLES=false
VITE_ENABLE_EXPERIMENTAL_INSIGHTS=false
VITE_ENABLE_EXPERIMENTAL_PHOTOS=false
VITE_ENABLE_EXPERIMENTAL_ROUTING=false

# Optional signal and ML profiles
TWITTER_BEARER_TOKEN=
SENTRY_DSN=
WHISPER_MODEL=base

# Optional blockchain profile
NOSTR_PRIVKEY=
BITCOIN_WIF=
BITCOIN_NETWORK=testnet
RELAY_URLS=

# Runtime tuning
MAX_DB_CONNECTIONS=50
LOG_LEVEL=info
