{
  "version": 8,
  "name": "SentinelMesh Light",
  "glyphs": "{GLYPHS_URL}",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "{TILE_SOURCE}",
      "attribution": "&copy; <a href='https://stadiamaps.com/' target='_blank'>Stadia Maps</a> &copy; <a href='https://openmaptiles.org/' target='_blank'>OpenMapTiles</a> &copy; <a href='https://www.openstreetmap.org/copyright' target='_blank'>OpenStreetMap</a>"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f8f6f1" } },
    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["==", "class", "residential"], "paint": { "fill-color": "#f1eee8", "fill-opacity": 0.7 } },
    { "id": "landuse-commercial", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["in", "class", "commercial", "retail"], "paint": { "fill-color": "#f5e9e5", "fill-opacity": 0.65 } },
    { "id": "landuse-industrial", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["==", "class", "industrial"], "paint": { "fill-color": "#eeeae2", "fill-opacity": 0.75 } },
    { "id": "parks", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": { "fill-color": "#dcebd6", "fill-opacity": 0.85 } },
    { "id": "landcover-green", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["in", "class", "wood", "grass", "scrub"], "paint": { "fill-color": "#e2eedc", "fill-opacity": 0.72 } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#c9e5f2" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 8, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#acd5e9", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 2.2] } },
    { "id": "building-fill", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#e5dfd7", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0.45, 15, 0.9] } },
    { "id": "building-outline", "type": "line", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "line-color": "#c9c0b5", "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.35, 17, 0.9] } },
    { "id": "admin-boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "filter": ["==", "admin_level", 2], "paint": { "line-color": "#9e9aa4", "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.6, 8, 1.4] } },
    { "id": "admin-boundary-region", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "filter": ["in", "admin_level", 3, 4, 5], "minzoom": 4, "paint": { "line-color": "#bbb5bd", "line-dasharray": [4, 3], "line-width": 0.8 } },
    { "id": "road-casing-motorway-trunk", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", "class", "motorway", "trunk"], "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#d59b69", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.4, 12, 8, 18, 22] } },
    { "id": "road-casing-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", "class", "primary"], "minzoom": 7, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#d8aa79", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.2, 14, 9, 18, 18] } },
    { "id": "road-casing-secondary-tertiary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", "class", "secondary", "tertiary"], "minzoom": 9, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#d4c4ae", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1, 14, 6.2, 18, 13] } },
    { "id": "road-casing-local", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", "class", "minor", "residential", "living_street", "service"], "minzoom": 12, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#d3cec7", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 15, 4.5, 18, 10] } },
    { "id": "road-fill-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", "class", "motorway"], "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#f3bd75", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 12, 6.5, 18, 19] } },
    { "id": "road-fill-trunk", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", "class", "trunk"], "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#f6d08d", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.7, 12, 6, 18, 18] } },
    { "id": "road-fill-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", "class", "primary"], "minzoom": 7, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#f8dfa9", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.6, 14, 7.2, 18, 15] } },
    { "id": "road-fill-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", "class", "secondary"], "minzoom": 9, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#fff4d5", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 14, 4.7, 18, 10.5] } },
    { "id": "road-fill-tertiary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", "class", "tertiary"], "minzoom": 10, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#fffaf0", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 4.3, 18, 9.5] } },
    { "id": "road-fill-local", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", "class", "minor", "residential", "living_street", "service"], "minzoom": 12, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.3, 15, 3.2, 18, 7.5] } },
    { "id": "paths", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", "class", "path", "track"], "minzoom": 13, "paint": { "line-color": "#b9aa94", "line-dasharray": [2, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 18, 2.2] } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", "class", "rail", "transit"], "minzoom": 10, "paint": { "line-color": "#9d9994", "line-dasharray": [3, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 17, 2] } },
    { "id": "road-label-major", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary"], "minzoom": 11, "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Stadia Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 16, 13], "text-max-angle": 30 }, "paint": { "text-color": "#63594f", "text-halo-color": "#fffdf8", "text-halo-width": 1.5 } },
    { "id": "road-label-local", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "filter": ["in", "class", "minor", "residential", "living_street", "service"], "minzoom": 14, "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Stadia Regular"], "text-size": 11, "text-max-angle": 30 }, "paint": { "text-color": "#766d64", "text-halo-color": "#ffffff", "text-halo-width": 1.3 } },
    { "id": "poi-useful", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "filter": ["any", ["in", "class", "hospital", "police", "fire_station", "pharmacy", "school", "fuel", "bus", "railway", "airport", "town_hall"], ["in", "subclass", "hospital", "police", "fire_station", "pharmacy", "school", "fuel", "bus_station", "station", "airport", "townhall", "courthouse"]], "minzoom": 13, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Stadia Semibold"], "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 17, 12], "text-max-width": 9, "text-padding": 3 }, "paint": { "text-color": "#385f5b", "text-halo-color": "#fffdf8", "text-halo-width": 1.5 } },
    { "id": "airport-label", "type": "symbol", "source": "openmaptiles", "source-layer": "aerodrome_label", "minzoom": 9, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"], ["get", "iata"]], "text-font": ["Stadia Semibold"], "text-size": 12, "text-max-width": 9 }, "paint": { "text-color": "#4d606c", "text-halo-color": "#fffdf8", "text-halo-width": 1.5 } },
    { "id": "building-label", "type": "symbol", "source": "openmaptiles", "source-layer": "building", "minzoom": 16, "filter": ["has", "name"], "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Stadia Regular"], "text-size": 10, "text-max-width": 7 }, "paint": { "text-color": "#6c655e", "text-halo-color": "#f8f6f1", "text-halo-width": 1.2 } },
    { "id": "place-label-neighbourhood", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["in", "class", "suburb", "quarter", "neighbourhood"], "minzoom": 11, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Stadia Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 15, 14], "text-letter-spacing": 0.08, "text-max-width": 8 }, "paint": { "text-color": "#736c65", "text-halo-color": "#fffdf8", "text-halo-width": 1.5 } },
    { "id": "place-label-locality", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["in", "class", "town", "village", "hamlet"], "minzoom": 7, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Stadia Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 7, 11, 14, 16], "text-max-width": 8, "symbol-sort-key": 2 }, "paint": { "text-color": "#464440", "text-halo-color": "#fffdf8", "text-halo-width": 1.8 } },
    { "id": "place-label-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", "class", "city"], "minzoom": 3, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Stadia Semibold"], "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 10, 17, 14, 20], "text-max-width": 8, "symbol-sort-key": 1 }, "paint": { "text-color": "#343431", "text-halo-color": "#fffdf8", "text-halo-width": 2 } },
    { "id": "place-label-country", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", "class", "country"], "maxzoom": 8, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Stadia Semibold"], "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 6, 15], "text-letter-spacing": 0.1, "text-max-width": 7, "symbol-sort-key": 0 }, "paint": { "text-color": "#4d5050", "text-halo-color": "#fffdf8", "text-halo-width": 1.8 } }
  ]
}
